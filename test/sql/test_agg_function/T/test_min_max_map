-- name: test_min_max_map
DROP DATABASE IF EXISTS min_max_map_${uuid0};
CREATE DATABASE min_max_map_${uuid0};
USE min_max_map_${uuid0};

CREATE TABLE min_max_map_test (
    id INT,
    grp INT,
    m_int MAP<INT, INT>,
    m_string MAP<VARCHAR(20), VARCHAR(20)>,
    m_decimal MAP<INT, DECIMAL(18, 2)>,
    m_date MAP<INT, DATE>
)
DUPLICATE KEY(id)
DISTRIBUTED BY HASH(id) BUCKETS 3
PROPERTIES ("replication_num" = "1");

INSERT INTO min_max_map_test VALUES
    (1, 1, map{1:10, 2:20, 3:NULL, NULL:4}, map{'a':'z', 'b':'m'},
        map{1:1.25, 2:10.00}, map{1:'2024-01-03'}),
    (2, 1, map{1:5, 3:NULL, NULL:8}, map{'a':'a'},
        map{1:2.50}, map{1:'2024-01-01'}),
    (3, 2, map{1:20, 2:40, 4:-7}, map{'a':'q', 'b':'x'},
        map{1:-3.75, 2:20.00}, map{1:'2024-01-05'}),
    (4, 2, NULL, NULL, NULL, NULL),
    (5, 2, map{}, map{}, map{}, map{});

SELECT cardinality(min_map(m_int)), cardinality(max_map(m_int)) FROM min_max_map_test;

SELECT min_map(m_int)[1], min_map(m_int)[2], min_map(m_int)[3], min_map(m_int)[4], min_map(m_int)[NULL],
       max_map(m_int)[1], max_map(m_int)[2], max_map(m_int)[3], max_map(m_int)[4], max_map(m_int)[NULL]
FROM min_max_map_test;

SELECT min_map(m_string)['a'], min_map(m_string)['b'],
       max_map(m_string)['a'], max_map(m_string)['b']
FROM min_max_map_test;

SELECT typeof(min_map(m_decimal)), min_map(m_decimal)[1], min_map(m_decimal)[2],
       typeof(max_map(m_decimal)), max_map(m_decimal)[1], max_map(m_decimal)[2]
FROM min_max_map_test;

SELECT typeof(min_map(m_date)), min_map(m_date)[1],
       typeof(max_map(m_date)), max_map(m_date)[1]
FROM min_max_map_test;

SELECT grp, min_map(m_int)[1], min_map(m_int)[2], min_map(m_int)[NULL],
       max_map(m_int)[1], max_map(m_int)[2], max_map(m_int)[NULL]
FROM min_max_map_test
GROUP BY grp
ORDER BY grp;

SELECT min_map(NULL), typeof(min_map(NULL)), max_map(NULL), typeof(max_map(NULL));

SELECT min_map(m), max_map(m)
FROM (
    SELECT CAST(NULL AS MAP<INT, INT>) AS m
    UNION ALL
    SELECT CAST(NULL AS MAP<INT, INT>)
) t;

SELECT min_map(m), max_map(m)
FROM (
    SELECT CAST(map{} AS MAP<INT, INT>) AS m
    UNION ALL
    SELECT CAST(map{} AS MAP<INT, INT>)
) t;

SELECT min_map(m), max_map(m)
FROM (
    SELECT map{1:CAST(NULL AS INT)} AS m
    UNION ALL
    SELECT map{1:CAST(NULL AS INT)}
) t;

SELECT cardinality(min_map(m)), min_map(m)[NULL], min_map(m)[1],
       cardinality(max_map(m)), max_map(m)[NULL], max_map(m)[1]
FROM (
    SELECT map{NULL:4, 1:10} AS m
    UNION ALL
    SELECT map{NULL:8, 1:5}
) t;

-- MAP constructors canonicalize duplicate keys before aggregation and keep the last value.
SELECT min_map(m)[1], min_map(m)[2], max_map(m)[1], max_map(m)[2]
FROM (
    SELECT map_from_arrays([1, 1, 2], [0, 10, 100]) AS m
    UNION ALL
    SELECT map{1:20}
) t;

SELECT typeof(min_map(m)), min_map(m)[1], typeof(max_map(m)), max_map(m)[1]
FROM (
    SELECT map{1:CAST(1.25 AS DECIMALV2(18, 2))} AS m
    UNION ALL
    SELECT map{1:CAST(-2.75 AS DECIMALV2(18, 2))}
) t;

SELECT cardinality(min_map(m)), min_map(m)[1], min_map(m)[100000],
       cardinality(max_map(m)), max_map(m)[1], max_map(m)[100000]
FROM (
    SELECT map{generate_series:generate_series} AS m
    FROM TABLE(generate_series(1, 100000))
) t;

SET streaming_preaggregation_mode=force_streaming;
SELECT min_map(m_int)[1], min_map(m_int)[2], min_map(m_int)[NULL],
       max_map(m_int)[1], max_map(m_int)[2], max_map(m_int)[NULL]
FROM min_max_map_test;

SET streaming_preaggregation_mode=force_preaggregation;
SELECT min_map(m_int)[1], min_map(m_int)[2], min_map(m_int)[NULL],
       max_map(m_int)[1], max_map(m_int)[2], max_map(m_int)[NULL]
FROM min_max_map_test;
SET streaming_preaggregation_mode=auto;

DROP DATABASE min_max_map_${uuid0};
